{
  "uid": "order-platform",
  "title": "Order Platform",
  "tags": ["kafka", "saga", "outbox"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Events applied per second",
      "description": "Work that actually ran, by consumer group. Duplicates are excluded so a redelivery storm cannot masquerade as throughput.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (group) (rate(platform_events_processed_total{outcome=\"applied\"}[1m]))",
          "legendFormat": "{{group}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Duplicate delivery rate",
      "description": "Share of deliveries the deduplication table rejected. A persistently non-zero line points at rebalances or a republishing producer.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (group) (rate(platform_events_processed_total{outcome=\"duplicate\"}[1m])) / clamp_min(sum by (group) (rate(platform_events_processed_total[1m])), 0.001)",
          "legendFormat": "{{group}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Outbox backlog age",
      "description": "How long the oldest unpublished row has waited. Depth alone spikes on any write burst; age stays flat while the relay keeps up and climbs without bound when it stops.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (service) (platform_outbox_backlog_age_seconds)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbox depth",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (service) (platform_outbox_backlog)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Consumer lag",
      "description": "Records behind the log end. This is the number that tells you whether consumers are keeping pace with producers.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (service, client_id) (kafka_consumer_fetch_manager_records_lag_max)",
          "legendFormat": "{{service}} / {{client_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Outbox drain time (p99)",
      "description": "Claim-and-publish latency for one batch. Rising p99 here precedes backlog age rising, so it is the earlier warning.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (service) (platform_outbox_drain_seconds{quantile=\"0.99\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    }
  ]
}
