<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.evelynkk</groupId>
    <artifactId>event-driven-order-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Event-Driven Order Platform</name>
    <description>Event-driven e-commerce order fulfillment platform built on Kafka choreographed sagas,
        with a transactional outbox, effectively-once consumption, and dead-letter recovery.</description>

    <modules>
        <module>platform-events</module>
        <module>platform-messaging</module>
        <module>order-service</module>
        <module>inventory-service</module>
        <module>payment-service</module>
        <module>shipping-service</module>
        <module>notification-service</module>
        <module>analytics-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.2.12</spring-boot.version>
        <!--
          Ahead of the version Spring Boot 3.2 manages. The bundled docker-java negotiates Docker
          API 1.32, which Docker Engine 25+ refuses; 1.20.x speaks 1.41 and works against both old
          CI daemons and current local ones.
        -->
        <testcontainers.version>1.20.6</testcontainers.version>
        <!--
          Docker Engine 25+ rejects the API version docker-java negotiates by default (1.32), so
          integration tests cannot reach the daemon without being told which version to speak.
          Override with -Ddocker.api.version=... against an older daemon.
        -->
        <docker.api.version>1.43</docker.api.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              Declared before spring-boot-dependencies on purpose. Maven resolves an imported BOM
              with the properties of the POM that declares it, so overriding Boot's
              testcontainers.version has no effect; importing the newer BOM first does, because the
              first declaration of a managed dependency wins.
            -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.evelynkk</groupId>
                <artifactId>platform-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.evelynkk</groupId>
                <artifactId>platform-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                      spring-boot-starter-parent sets this for you; importing the BOM instead does
                      not. Without parameter names in the bytecode, Spring cannot infer them for
                      @RequestParam, @PathVariable, or constructor binding, and those fail at
                      request time rather than at startup.
                    -->
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
